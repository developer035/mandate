{
  "name": "mandate-restock-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Household restock AI agent with spending limits enforced by code - PayPal AI Hackathon",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=client",
    "start": "node server/src/index.js",
    "test:cases": "node scripts/run-tests.js",
    "paypal:poc": "node scripts/paypal-poc.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
